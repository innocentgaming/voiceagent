{
  "name": "indicvoice-lab",
  "version": "1.0.0",
  "description": "IndicVoice Lab - An Indian-language Voice Agent Testing Platform for Gnani AI Challenge",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "test": "cd server && npm test",
    "seed": "cd server && node scripts/seed.js",
    "test:gnani": "cd server && node scripts/testGnaniLive.js",
    "gen:audio": "cd server && node scripts/generateSampleWavs.js"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "multer": "^1.4.5-lts.2"
  },
  "keywords": [
    "indic-speech",
    "voice-agent",
    "stt-evaluation",
    "gnani-prisma",
    "wer",
    "cer",
    "critical-entities",
    "hindi",
    "marathi",
    "hinglish"
  ],
  "author": "IndicVoice Lab Team",
  "license": "MIT"
}
