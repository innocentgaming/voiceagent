# Server configuration
PORT=5000
NODE_ENV=development

# Gnani Prisma STT Credentials
# (If omitted or invalid, IndicVoice Lab will automatically use realistic mock simulation)
GNANI_PRISMA_API_KEY=your_gnani_api_key_here
GNANI_PRISMA_ACCESS_KEY=your_gnani_access_key_here
GNANI_PRISMA_ENDPOINT=https://prisma.gnani.ai/api/v1/stt

# Database (Optional - defaults to zero-config local JSON storage if omitted)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/indicvoicelab?retryWrites=true&w=majority
