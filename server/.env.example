# Server configuration
PORT=5000
NODE_ENV=development

# Live Gnani AI (Vachana AI) STT Credentials
# Get your API key from Gnani AI / Vachana portal
GNANI_API_KEY_ID=vach_your_api_key_id_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
GNANI_PRISMA_MODEL=prisma-v3.0
USE_MOCK_PRISMA=false

# Database (Optional - defaults to zero-config local JSON storage if omitted)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/indicvoicelab?retryWrites=true&w=majority

